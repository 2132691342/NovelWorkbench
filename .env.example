# NovelWorkbench 根目录 docker compose 环境变量模板。
# 用法：cp .env.example .env，然后填写真实值。.env 已被 .gitignore 忽略，切勿提交。
# 说明：以下均为占位值，部署时必须替换为自己的凭据与地址。

# ---- 安全与引导 ----
NW_JWT_SECRET=replace-with-a-long-random-secret
NW_APP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
NW_APP_BUILD_VERSION=dev

# ---- 中间件地址/凭据 ----
# 生产环境填写云服务器地址；本地全栈（--profile infra）使用下方服务名。
NW_POSTGRES_HOST=postgres
NW_POSTGRES_PORT=5432
NW_POSTGRES_USER=postgres
NW_POSTGRES_PASSWORD=replace-with-db-password
NW_POSTGRES_DBNAME=postgres

NW_REDIS_ADDR=redis:6379
NW_REDIS_PASSWORD=replace-with-redis-password

NW_RABBITMQ_USER=localdevuser
NW_RABBITMQ_PASSWORD=replace-with-rabbitmq-password
NW_RABBITMQ_URL=amqp://localdevuser:replace-with-rabbitmq-password@rabbitmq:5672/

NW_MINIO_ENDPOINT=minio:9000
NW_MINIO_ACCESS_KEY=replace-with-minio-access-key
NW_MINIO_SECRET_KEY=replace-with-minio-secret-key

NW_MANTICORE_BASE_URL=http://manticore:9308

# ---- 出厂默认模型供应商（仅 model_providers 表为空时播种一次） ----
NW_AI_PROTOCOL_CODE=openai
NW_AI_BASE_URL=https://model-gateway.example.com/v1
NW_AI_API_KEY=replace-with-model-api-key
NW_AI_CHAT_MODEL=replace-with-chat-model

# ---- 可调参数（均留空时用后端内置默认值） ----
# NW_SERVER_PORT=8080                        # 后端监听端口
# NW_AI_TEMPERATURE=0.7                      # 采样温度
# NW_AI_MAX_TOKENS=2048                      # 单次输出上限
# NW_AI_TIMEOUT_SEC=120                      # 单次模型调用超时（秒）
# NW_AI_HISTORY_COUNT=5                      # AI 对话默认注入历史条数
# NW_APP_UPLOAD_MAX_MB=20                    # 知识库上传大小上限（MB）
# NW_APP_CHUNK_SIZE=800                      # 知识库切片字符数
# NW_APP_CHUNK_OVERLAP=120                   # 知识库切片重叠字符数
# NW_APP_RAG_TOP_K=6                         # 知识库默认召回条数
