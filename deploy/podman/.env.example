# NovelWorkbench podman 部署环境变量模板（cp .env.example .env 后填写；.env 不入库）。
# 以下均为占位值，必须替换；服务发现走中间件网络别名
# （postgres/redis/manticore/minio/rabbitmq），无需配置公网主机地址。

# ---- 必填：安全与凭据 ----
NW_JWT_SECRET=replace-with-a-long-random-secret
NW_POSTGRES_PASSWORD=replace-with-db-password
NW_REDIS_PASSWORD=replace-with-redis-password
NW_RABBITMQ_USER=replace-with-rabbitmq-user
NW_RABBITMQ_PASSWORD=replace-with-rabbitmq-password
NW_MINIO_ACCESS_KEY=replace-with-minio-access-key
NW_MINIO_SECRET_KEY=replace-with-minio-secret-key
NW_APP_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# ---- 必填：出厂默认模型供应商（供应商表为空时播种一次，之后在页面管理） ----
NW_AI_PROTOCOL_CODE=openai
NW_AI_BASE_URL=https://model-gateway.example.com/v1
NW_AI_API_KEY=replace-with-model-api-key
NW_AI_CHAT_MODEL=replace-with-chat-model

# ---- 可选 ----
# NW_APP_BUILD_VERSION=dev                     # 运行状态页展示的构建版本
# NW_INFRA_NETWORK=novelworkbench_default      # 既有中间件栈网络名
# NW_NGINX_RESOLVER=10.89.0.1                  # podman 网络网关地址
# NW_API_UPSTREAM=http://backend.dns.podman:8080
# NW_BASE_IMAGE_PREFIX=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/library
# NW_BACKEND_IMAGE=localhost/novel-workbench-backend:latest
# NW_FRONTEND_IMAGE=localhost/novel-workbench-frontend:latest
