# NovelWorkbench podman 部署环境变量（cp .env.example .env 后填写；.env 不入库）。
# 服务发现走中间件网络别名（postgres/redis/manticore/minio/rabbitmq），无需配置主机地址。

# ---- 必填：安全与凭据 ----
NW_JWT_SECRET=            # JWT 签名密钥（随机长串，必改）
NW_POSTGRES_PASSWORD=     # PostgreSQL 口令
NW_REDIS_PASSWORD=        # Redis 口令
NW_RABBITMQ_USER=admin    # RabbitMQ 用户
NW_RABBITMQ_PASSWORD=     # RabbitMQ 口令
NW_MINIO_ACCESS_KEY=      # MinIO AccessKey
NW_MINIO_SECRET_KEY=      # MinIO SecretKey
NW_APP_ADMIN_PASSWORD=    # 引导管理员初始密码（仅用户表为空时生效，首登后改密）

# ---- 必填：出厂默认模型供应商（供应商表为空时播种一次，之后在页面管理） ----
NW_AI_PROTOCOL_CODE=openai            # openai / anthropic
NW_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
NW_AI_API_KEY=
NW_AI_CHAT_MODEL=qwen-plus
NW_AI_EMBEDDING_MODEL=                # 留空 = 仅关键词检索；Anthropic 协议不支持向量

# ---- 可选 ----
# NW_APP_BUILD_VERSION=dev              # 运行状态页展示的构建版本
# NW_INFRA_NETWORK=liteworkbench_default   # 中间件栈网络名
# NW_BASE_IMAGE_PREFIX=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/library  # 基础镜像前缀
# NW_BACKEND_IMAGE=localhost/novel-workbench-backend:latest
# NW_FRONTEND_IMAGE=localhost/novel-workbench-frontend:latest
