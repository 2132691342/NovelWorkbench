{
  "name": "novel-workbench-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NovelWorkbench AI 小说工作台前端",
  "scripts": {
    "dev": "vite --mode base",
    "build": "vue-tsc --noEmit --skipLibCheck && vite build --mode pro",
    "build:pro": "vite build --mode pro",
    "preview": "vite preview --mode pro",
    "ts:check": "vue-tsc --noEmit --skipLibCheck",
    "lint": "oxlint src",
    "clean": "rimraf dist node_modules/.cache",
    "test": "vitest run"
  },
  "dependencies": {
    "@antv/x6": "2.18.1",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@iconify-icons/mdi": "^1.2.48",
    "@novelworkbench/components": "workspace:*",
    "@novelworkbench/hooks": "workspace:*",
    "@novelworkbench/request": "workspace:*",
    "@novelworkbench/styles": "workspace:*",
    "@vueuse/core": "^14.4.0",
    "docx-preview": "0.3.4",
    "echarts": "^6.1.0",
    "element-plus": "catalog:",
    "marked": "^12.0.2",
    "nprogress": "^0.2.0",
    "pinia": "^4.0.2",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "catalog:",
    "vue-i18n": "11.4.8",
    "vue-pdf-embed": "2.1.7",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.2.4",
    "@types/node": "^26.2.0",
    "@types/nprogress": "^0.2.3",
    "@unocss/transformer-variant-group": "^66.7.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "autoprefixer": "^10.7.0",
    "esbuild": "^0.28.2",
    "less": "^4.8.1",
    "postcss": "^8.5.33",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "unocss": "^66.7.5",
    "vite": "8.2.1",
    "vitest": "2.1.9",
    "vue-tsc": "^3.3.9"
  }
}
